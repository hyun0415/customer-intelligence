ARG PYTORCH_IMAGE=pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime@sha256:77f17f843507062875ce8be2a6f76aa6aa3df7f9ef1e31d9d7432f4b0f563dee
FROM ${PYTORCH_IMAGE}

WORKDIR /app
COPY requirements-rag-rerank.txt ./
RUN python -m pip install \
    --no-cache-dir \
    --default-timeout=600 \
    --retries=10 \
    --prefer-binary \
    -r requirements-rag-rerank.txt

COPY src ./src
COPY backend ./backend

ENV PYTHONPATH=/app \
    RAG_RERANKER_ENABLED=true \
    RAG_RERANKER_DEVICE=cuda

EXPOSE 8000
CMD ["python", "-m", "uvicorn", "backend.reranker_main:app", "--host", "0.0.0.0", "--port", "8000"]
