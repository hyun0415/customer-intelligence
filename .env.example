# 1. 애플리케이션 실행 프로필
APP_ENV=development
# openai(기본) 또는 local(vLLM + BGE-M3)
MODEL_PROFILE=openai
# 하위 호환 또는 역할별 혼합 운영에만 사용
# MODEL_PROVIDER=openai

# 2. 데이터 저장소
# POSTGRES_*: Docker Compose가 PostgreSQL 컨테이너를 초기화할 때 사용
POSTGRES_DB=customer_intelligence
POSTGRES_USER=customer_intelligence
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# DB_*: Backend가 PostgreSQL에 연결할 때 사용
DB_NAME=customer_intelligence
DB_USER=customer_intelligence
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis: 로그인 세션, 작업 상태와 Aspect 추출 캐시에 사용
REDIS_PASSWORD=
REDIS_HOST=localhost
REDIS_PORT=6379

# 3. Web/API와 세션
FRONTEND_URL=http://localhost:3000
SESSION_COOKIE_NAME=ci_session
SESSION_COOKIE_SECURE=false
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Web 요청 대기시간과 비동기 작업 보존시간
AGENT_REQUEST_TIMEOUT_SECONDS=120
AGENT_JOB_TTL_SECONDS=3600
DEV_LOGIN_ENABLED=false

# 4. Google OIDC
# Google Cloud의 "웹 애플리케이션" OAuth Client 값을 사용
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
# Google Cloud에 등록한 redirect URI와 완전히 같아야 함
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
# Workspace 전용일 때 hosted domain을 쉼표로 구분. 비우면 개인 Google 계정도 허용
GOOGLE_WORKSPACE_DOMAINS=
# 선택적 추가 제한: 이메일 주소의 @ 뒤 도메인을 쉼표로 구분
OIDC_ALLOWED_DOMAINS=
OIDC_REQUIRE_VERIFIED_EMAIL=true
# 최초 관리자 계정 이메일. OIDC가 이메일을 검증한 뒤에만 적용
BOOTSTRAP_ADMIN_EMAILS=

# 5. OpenAI 프로필
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Agent 모델 호출의 timeout과 재시도
AGENT_TIMEOUT_SECONDS=90
AGENT_MAX_RETRIES=2

# 리뷰 Aspect Extractor
REVIEW_EXTRACTOR_MODEL=gpt-5.6-luna
REVIEW_EXTRACTOR_REASONING_EFFORT=low
REVIEW_EXTRACTOR_TIMEOUT_SECONDS=60
REVIEW_EXTRACTOR_MAX_RETRIES=1

# 정책 근거 판별기와 평가 모델
RAG_EVIDENCE_MODEL=gpt-5.6-luna
RAG_EVIDENCE_TIMEOUT_SECONDS=15
RAG_EVIDENCE_MAX_RETRIES=1
EVALUATOR_MODEL=gpt-5.6-sol

# 6. 선택 사항: 로컬 모델 프로필
# MODEL_PROFILE=local
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=local-vllm
# VLLM_AGENT_MODEL=openai/gpt-oss-20b
# VLLM_REVIEW_EXTRACTOR_MODEL=Qwen/Qwen3-8B
# VLLM_RAG_EVIDENCE_MODEL=Qwen/Qwen3-8B
# VLLM_EVALUATOR_MODEL=pytorch/gemma-3-27b-it-FP8

# 7. 선택 사항: 원격 BGE-M3 검색·재정렬 서비스
# 로컬 프로필은 같은 BGE-M3 서비스의 /embed와 /rerank를 사용
# RAG_EMBEDDING_PROVIDER=remote_bge_m3
# RAG_EMBEDDING_MODEL=BAAI/bge-m3
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_EMBEDDING_BASE_URL=http://gpu-host:8003
# RAG_RERANKER_BASE_URL=http://gpu-host:8003
# 공개 tunnel을 사용할 때만 충분히 긴 임의 토큰을 설정
# RAG_RERANKER_API_KEY=
# RAG_RERANKER_TIMEOUT_SECONDS=60
# RAG_RERANKER_CANDIDATE_LIMIT=10

# 8. 선택 사항: 역할별 provider와 endpoint 분리
# AGENT_MODEL_PROVIDER=vllm
# AGENT_MODEL_BASE_URL=http://qwen-agent:8000/v1
# REVIEW_EXTRACTOR_MODEL_PROVIDER=vllm
# REVIEW_EXTRACTOR_MODEL_BASE_URL=http://qwen-small:8000/v1
# RAG_EVIDENCE_MODEL_PROVIDER=vllm
# RAG_EVIDENCE_MODEL_BASE_URL=http://qwen-small:8000/v1
# EVALUATOR_MODEL_PROVIDER=vllm
# EVALUATOR_MODEL_BASE_URL=http://gemma-evaluator:8000/v1
