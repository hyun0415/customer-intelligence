      "stage": 1,
      "row": 4,
      "width": 160
    },
    {
      "id": "evidenceCheck",
      "type": "security",
      "label": "원문 Evidence 검증",
      "sublabel": "원문에 없는 근거 제거",
      "tag": "PYTHON",
      "stage": 2,
      "row": 1
    },
    {
      "id": "patternAggregate",
      "type": "backend",
      "label": "Aspect 집계",
