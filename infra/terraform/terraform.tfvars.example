# Safe default: copy this file to terraform.tfvars only when ready to create AWS resources.
enable_stack       = true
create_cpu_instance = true
create_gpu_instance = true

aws_profile = "terra-user"
aws_region  = "ap-northeast-2"

cpu_instance_type = "t3.large"

# Select an AWS Deep Learning GPU AMI that exists in aws_region.
gpu_ami_id        = "ami-REPLACE_WITH_DLAMI_ID"
gpu_instance_type = "p5.4xlarge"
gpu_use_spot      = false

# Replace latest with the tested tag or digest before final benchmarking.
vllm_image = "vllm/vllm-openai:latest"

tags = {
  Owner     = "customer-intelligence"
  Lifecycle = "ephemeral-validation"
}
