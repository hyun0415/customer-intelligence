      "stage": 3,
      "row": 2
    },
    {
      "id": "answer",
      "type": "frontend",
      "label": "업무 활용 답변",
      "sublabel": "반복 불만 · 영향 · 개선 우선순위",
      "tag": "OUTPUT",
      "stage": 3,
      "row": 4,
      "width": 160
    }
  ],
  "flows": [
    {
      "id": "questionToSelector",
      "from": "question",
      "to": "toolSelector",
      "label": "질문 의도",
      "classification": "natural language",
      "variant": "emphasis"
    },
    {
      "id": "selectorToSql",
      "from": "toolSelector",
      "to": "sqlTools",
      "label": "검증된 Tool 호출",
      "classification": "validated arguments",
      "variant": "security"
    },
    {
      "id": "sqlToDb",
      "from": "sqlTools",
      "to": "reviewDb",
      "label": "고정 Query",
      "classification": "deterministic SQL",
      "variant": "security"
    },
    {
      "id": "dbToExtractor",
      "from": "reviewDb",
      "to": "aspectExtractor",
      "label": "선별 리뷰 + 통계",
      "classification": "sampled evidence",
      "variant": "emphasis"
    },
    {
      "id": "extractorToEvidence",
      "from": "aspectExtractor",
      "to": "evidenceCheck",
      "label": "Aspect JSON",
      "classification": "structured extraction",
      "variant": "default",
      "labelDy": -50
    },
    {
      "id": "evidenceToAggregate",
      "from": "evidenceCheck",
      "to": "patternAggregate",
      "label": "검증된 Aspect",
      "classification": "validated evidence",
      "variant": "security"
    },
    {
      "id": "aggregateToContext",
      "from": "patternAggregate",
      "to": "structuredContext",
      "label": "빈도 · 비율 · 근거",
      "classification": "aggregated patterns",
      "variant": "emphasis",
      "labelDy": 53
    },
    {
      "id": "contextToAgent",
      "from": "structuredContext",
      "to": "finalAgent",
      "label": "구조화 입력",
      "classification": "tool result",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 50
    },
    {
      "id": "agentToAnswer",
      "from": "finalAgent",
      "to": "answer",
      "label": "분석 답변",
      "classification": "actionable insight",
      "variant": "emphasis",
      "route": "straight",
      "fromSide": "bottom",
      "toSide": "top",
      "labelDy": 50
    }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "결정론적 데이터 경계",
      "items": [
        "LLM은 SQL을 직접 작성하지 않고 사전에 구현된 Tool만 선택합니다.",
        "평점·비율·표본 수는 PostgreSQL과 Python 코드가 계산합니다."
      ]
    },
    {
      "dot": "violet",
      "title": "Aspect 기반 LLM 활용",
      "items": [
        "리뷰별 불만과 감성을 구조화하고 근거 문장을 함께 추출합니다.",
        "검증·집계된 결과만 Final Agent의 판단 근거로 전달합니다."
      ]
    }
  ]
}
