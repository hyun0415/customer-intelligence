# OpenAI 경로(기본값)
MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
REVIEW_EXTRACTOR_MODEL=gpt-5.6-luna
REVIEW_EXTRACTOR_REASONING_EFFORT=low
RAG_EVIDENCE_MODEL=gpt-5.6-luna
EVALUATOR_MODEL=gpt-5.6-sol

# 전체 역할을 하나의 OpenAI-compatible vLLM endpoint로 전환할 때 사용
# MODEL_PROVIDER=vllm
# VLLM_BASE_URL=http://localhost:8000/v1
# VLLM_API_KEY=local-vllm
# VLLM_AGENT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
# VLLM_REVIEW_EXTRACTOR_MODEL=Qwen/Qwen3-8B
# VLLM_RAG_EVIDENCE_MODEL=Qwen/Qwen3-8B
# VLLM_EVALUATOR_MODEL=google/gemma-3-27b-it

# 역할별 provider와 endpoint를 다르게 운영할 때 선택적으로 사용
# AGENT_MODEL_PROVIDER=vllm
# AGENT_MODEL_BASE_URL=http://qwen-agent:8000/v1
# REVIEW_EXTRACTOR_MODEL_PROVIDER=vllm
# REVIEW_EXTRACTOR_MODEL_BASE_URL=http://qwen-small:8000/v1
# RAG_EVIDENCE_MODEL_PROVIDER=vllm
# RAG_EVIDENCE_MODEL_BASE_URL=http://qwen-small:8000/v1
# EVALUATOR_MODEL_PROVIDER=vllm
# EVALUATOR_MODEL_BASE_URL=http://gemma-evaluator:8000/v1
