{
  "schema_version": 1,
  "diagram_type": "dataflow",
  "meta": {
    "title": "검증된 SQL과 Aspect 기반 고객 리뷰 분석 Agent",
    "subtitle": "LLM은 Tool을 선택하고, 검증된 코드가 조회·검증·집계를 수행합니다",
    "output": "docs/customer_review_agent_flow.html",
    "viewBox": [1080, 820],
    "animation": "none",
    "visual_preset": "editorial",
    "quality_profile": "showcase"
  },
  "stages": [
    { "label": "① 검증된 SQL 조회" },
    { "label": "② Aspect 구조화" },
    { "label": "③ 원문 검증·집계" },
    { "label": "④ 근거 기반 답변" }
  ],
  "nodes": [
    {
      "id": "question",
      "type": "frontend",
      "label": "사용자 질문",
      "sublabel": "자연어 분석 요청",
      "tag": "INPUT",
      "stage": 0,
      "row": 0
    },
    {
      "id": "toolSelector",
      "type": "backend",
      "label": "Agent Tool 선택",
      "sublabel": "직접 SQL 생성 없음",
      "tag": "LANGGRAPH",
      "stage": 0,
      "row": 2
    },
    {
      "id": "sqlTools",
      "type": "security",
      "label": "검증된 SQL Tool",
      "sublabel": "고정 Query · 입력 검증",
      "tag": "GUARDRAIL",
      "stage": 0,
      "row": 4
    },
    {
      "id": "reviewDb",
      "type": "database",
      "label": "PostgreSQL",
      "sublabel": "리뷰 표본 · 정량 통계",
      "tag": "203,648 REVIEWS",
      "stage": 1,
      "row": 1
    },
    {
      "id": "aspectExtractor",
      "type": "cloud",
      "label": "Aspect Extractor LLM",
      "sublabel": "불만 · 감성 · 직접 경험 · Evidence",
